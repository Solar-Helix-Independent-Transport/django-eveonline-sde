{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-sde-key": "categoryID",
    "type": "object",
    "properties": {
        "categoryID": {
            "type": "integer",
            "format": "int32"
        },
        "iconID": {
            "type": "integer",
            "format": "int32"
        },
        "name": {
            "$ref": "#/$defs/Localized"
        },
        "published": {
            "type": "boolean"
        }
    },
    "required": [
        "categoryID",
        "name",
        "published"
    ],
    "additionalProperties": false,
    "$defs": {
        "Localized": {
            "type": "object",
            "properties": {
                "de": {
                    "type": "string"
                },
                "en": {
                    "type": "string"
                },
                "es": {
                    "type": "string"
                },
                "fr": {
                    "type": "string"
                },
                "ja": {
                    "type": "string"
                },
                "ko": {
                    "type": "string"
                },
                "ru": {
                    "type": "string"
                },
                "zh": {
                    "type": "string"
                }
            },
            "required": [
                "en"
            ],
            "additionalProperties": false
        }
    }
}
